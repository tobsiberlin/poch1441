      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Geschichte entdecken" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Discover the story" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Descubrir la historia" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Découvrir l’histoire" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Scopri la storia" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Ontdek het verhaal" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Odkryj historię" } }
      }
    },
    "firstRun.timeSwipe.prelude.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Fast 600 Jahre Geschichte. Jetzt beginnt deine Runde." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A game with nearly 600 years of history." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Un juego con casi 600 años de historia." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un jeu avec près de 600 ans d’histoire." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Un gioco con quasi 600 anni di storia." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Een spel met bijna 600 jaar geschiedenis." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Gra z prawie 600-letnią historią." } }
      }
    },
    "firstRun.timeSwipe.origin.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die ältesten bekannten Spuren führen ins Jahr 1441. Schon damals verband Poch Trumpf, Einsatz und das Rennen um die letzte Karte." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The first traces lead to 1441: cards, stakes, and three very different games in one round." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las primeras huellas llevan a 1441: cartas, apuestas y tres juegos muy distintos en una ronda." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les premières traces remontent à 1441 : cartes, mises et trois jeux très différents en une manche." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Le prime tracce risalgono al 1441: carte, puntate e tre giochi diversi in un turno." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "De eerste sporen leiden naar 1441: kaarten, inzet en drie heel verschillende spellen in één ronde." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Pierwsze ślady prowadzą do 1441 roku: karty, stawki i trzy różne gry w jednej rundzie." } }
      }
    },
    "firstRun.timeSwipe.origin.eyebrow" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "1441" } },
