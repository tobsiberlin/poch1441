    "help.bonus.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bestimmte Trumpfkarten gewinnen sie sofort." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Certain trump cards win them immediately." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Algunas cartas de triunfo los ganan al instante." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Certaines cartes d'atout les gagnent immédiatement." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Alcune carte di briscola li vincono subito." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Bepaalde troefkaarten winnen ze meteen." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Wybrane atuty wygrywają je od razu." } }
      }
    },
    "help.center.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wer zuerst keine Karten mehr hat, gewinnt sie." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "First to run out of cards wins it." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La gana quien se queda primero sin cartas." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La première personne sans cartes la remporte." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La vince chi finisce per primo le carte." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Wie het eerst geen kaarten meer heeft, wint het midden." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Wygrywa ją ten, kto pierwszy pozbędzie się kart." } }
      }
    },
    "help.overview.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Drei Wege zu gewinnen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Three ways to win" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tres formas de ganar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Trois façons de gagner" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Tre modi per vincere" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Drie manieren om te winnen" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Trzy sposoby na wygraną" } }
      }
    },
    "help.poch.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Mit Paar, Drilling oder Vierling bietest du um ihn." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "With a pair, triple, or four of a kind, you bid for it." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Con una pareja, un trío o cuatro iguales pujas por él." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Avec une paire, un brelan ou un carré, tu mises pour le remporter." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Con una coppia, un tris o un poker punti per vincerlo." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Met een paar, drieling of vierling bied je erom." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Z parą, trójką lub karetą licytujesz o niego." } }
      }
    },
    "help.visual.bid.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Mit einem Paar darfst du pochen. Vierling schlägt Drilling, Drilling schlägt Paar." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A pair lets you poch. Four of a kind beats a triple, and a triple beats a pair." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Una pareja te permite hacer poch. Cuatro iguales ganan al trío y el trío a la pareja." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une paire te permet de pocher. Le carré bat le brelan et le brelan bat la paire." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Una coppia ti permette di fare poch. Il poker batte il tris e il tris batte la coppia." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Met een paar mag je pochen. Een vierling verslaat een drieling en een drieling een paar." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Para pozwala zagrać w Poch. Kareta bije trójkę, a trójka parę." } }
      }
    },
    "help.visual.meld.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dein Trumpf-König gewinnt das König-Bonusfeld - und bleibt in deiner Hand." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your trump King wins the King pot - and stays in your hand." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu Rey de triunfo gana el bote del Rey y se queda en tu mano." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ton Roi d'atout gagne le pot du Roi et reste dans ta main." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il tuo Re di briscola vince il piatto del Re e resta nella tua mano." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je troefheer wint de Herenpot en blijft in je hand." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Twój król atutowy wygrywa pulę króla i zostaje w ręce." } }
      }
    },
    "help.visual.play.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auf jede Karte folgt die nächsthöhere derselben Farbe. Wer zuletzt legt, eröffnet neu." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Each card is followed by the next higher card in the same suit. Whoever plays last leads again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "A cada carta le sigue la inmediatamente superior del mismo palo. Quien juegue la última vuelve a abrir." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chaque carte est suivie de la carte immédiatement supérieure de la même couleur. Celui qui joue en dernier ouvre à nouveau." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "A ogni carta segue quella immediatamente superiore dello stesso seme. Chi gioca per ultimo apre di nuovo." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Op elke kaart volgt de eerstvolgende hogere kaart van dezelfde kleur. Wie als laatste speelt, opent opnieuw." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Po każdej karcie następuje kolejna wyższa w tym samym kolorze. Kto zagra ostatni, otwiera nową sekwencję." } }
      }
    },
    "help.backToTable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zurück zum Tisch" } },
