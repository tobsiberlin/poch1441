    "tutorial.bidding.commit.body.one" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Du setzt 1 Chip. Jetzt können die anderen mitgehen, erhöhen oder passen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You stake 1 chip. Now the others can call, raise, or fold." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Apuestas 1 ficha. Ahora los demás pueden igualar, subir o pasar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tu mises 1 jeton. Les autres peuvent maintenant suivre, relancer ou passer." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Punti 1 fiche. Ora gli altri possono vedere, rilanciare o passare." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je zet 1 fiche in. Nu kunnen de anderen meegaan, verhogen of passen." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Stawiasz 1 żeton. Teraz pozostali mogą sprawdzić, podbić albo spasować." } }
      }
    },
