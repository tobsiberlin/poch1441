    "tutorial.meld.ante.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt füllt ihr die Bonusfelder"
          }
        },
        "en" : {
          "stringUnit" : {
