    "menu.hero.bid.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dein Einsatz bleibt im Poch-Pott. Danach entscheiden die anderen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your stake stays in the Poch. Then the others decide." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu apuesta queda en el Poch. Después deciden los demás." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ta mise reste dans le Poch. Ensuite, les autres décident." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La tua puntata resta nel Poch. Poi decidono gli altri." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je inzet blijft in de Poch. Daarna beslissen de anderen." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Twoja stawka zostaje w Poch. Potem decydują pozostali." } }
      }
    },
    "menu.hero.bid.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dein Gebot steht" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your bid stands" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu apuesta sigue en pie" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ton enchère tient" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La tua offerta resta" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je bod blijft staan" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Twoja stawka zostaje" } }
      }
    },
    "menu.hero.meld.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Karten und Chips bleiben genau so liegen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cards and pots stay exactly as they are." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las cartas y los botes quedan exactamente como están." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les cartes et les pots restent exactement en place." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Carte e piatti restano esattamente come sono." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Kaarten en potten blijven precies zo liggen." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Karty i pule pozostają dokładnie na swoich miejscach." } }
      }
    },
    "menu.hero.meld.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Karten warten" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your cards are waiting" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus cartas esperan" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tes cartes t'attendent" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Le tue carte aspettano" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je kaarten wachten" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Twoje karty czekają" } }
      }
    },
    "menu.hero.play.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Hand und die aktuelle Reihe bleiben genau so liegen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your hand and the current run stay exactly as they are." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu mano y la serie actual quedan exactamente como están." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ta main et la suite en cours restent exactement en place." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La tua mano e la sequenza restano esattamente come sono." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Je hand en de huidige reeks blijven precies zo liggen." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Twoja ręka i obecny ciąg pozostają dokładnie bez zmian." } }
      }
    },
    "menu.hero.play.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Reihe bleibt offen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The run stays open" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La serie queda abierta" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La suite reste ouverte" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La sequenza resta aperta" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "De reeks blijft open" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Ciąg pozostaje otwarty" } }
      }
    },
    "overlay.help.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "DREI WEGE. EINE RUNDE." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "THREE WAYS. ONE ROUND." } },
