    "firstRun.timeSwipe.origin.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "1441: Ein Tisch, drei Chancen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Poch begins at the tavern table." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Poch comienza en la mesa de la taberna." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Poch commence à la table de l’auberge." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Poch comincia al tavolo della taverna." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Poch begint aan de herbergtafel." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Poch zaczyna się przy stole w karczmie." } }
      }
    },
    "firstRun.timeSwipe.skip" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Geschichte überspringen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Skip the story" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Saltar la historia" } },
