    "firstRun.timeSwipe.branch.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Über das französische Poque führt eine mögliche Entwicklungslinie zum Poker. Poch bleibt ein eigenes Spiel." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A possible line runs through French Poque to poker. Poch remains a game of its own." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Una posible línea pasa por el Poque francés hasta el póquer. Poch sigue siendo un juego propio." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une filiation possible passe par le Poque français jusqu’au poker. Le Poch reste un jeu à part entière." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Una possibile linea passa dal Poque francese al poker. Poch resta un gioco a sé." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Een mogelijke lijn loopt via het Franse Poque naar poker. Poch blijft een eigen spel." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Możliwa linia prowadzi przez francuskie Poque do pokera. Poch pozostaje osobną grą." } }
      }
    },
