    "tutorial.bidding.allPassed.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Chips bleiben liegen. In der nächsten Runde kommt der neue Einsatz dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chips stay put. The next round adds a new stake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fichas se quedan donde están. La próxima ronda añade una nueva apuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jetons restent en place. La prochaine manche ajoute une nouvelle mise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fiche restano dove sono. Il prossimo turno aggiunge una nuova puntata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fiches blijven liggen. In de volgende ronde komt er een nieuwe inzet bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żetony zostają na miejscu. W następnej rundzie dojdzie nowa stawka."
          }
        }
      }
    },
    "tutorial.bidding.allPassed.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle passen - der Poch-Pott wächst weiter"
          }
        },
        "en" : {
          "stringUnit" : {
