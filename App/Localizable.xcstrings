          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje Małżeństwo płaci trzy razy"
          }
        }
      }
    },
    "tutorial.meld.connect.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karo ist Trumpf. Zeig den König: Du bekommst die Chips aus seinem Bonusfeld. Die Karte bleibt in deiner Hand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamonds are trump. Show the king: you take the chips from its bonus field. The card stays in your hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diamantes es triunfo. Muestra el rey: recoges las fichas de su casilla de premio. La carta se queda en tu mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carreau est l’atout. Montre le roi : tu prends les jetons de sa case bonus. La carte reste dans ta main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadri è briscola. Mostra il re: prendi le fiche dalla sua casella bonus. La carta resta nella tua mano."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruiten is troef. Toon de koning: je pakt de fiches uit zijn bonusvak. De kaart blijft in je hand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karo jest atutem. Pokaż króla: zabierasz żetony z jego pola bonusowego. Karta zostaje w twojej ręce."
          }
        }
      }
    },
    "tutorial.meld.connect.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Karo-König gewinnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your diamond king wins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu rey de diamantes gana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton roi de carreau gagne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo re di quadri vince."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ruitenkoning wint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój król karo wygrywa."
          }
        }
      }
    },
    "tutorial.meld.drag.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mitte wartet bis zum Schluss. Wer seine Hand zuerst leerspielt, gewinnt alle Chips darin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put it in the centre. The first player to shed all their cards wins it at the end of the round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponla en el centro. Quien se quede primero sin cartas la gana al final de la ronda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place-le au centre. Le premier à se débarrasser de toutes ses cartes le remporte à la fin de la manche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettila al centro. Chi finisce per primo le carte la vince alla fine del turno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg hem in het midden. Wie als eerste al zijn kaarten kwijt is, wint hem aan het einde van de ronde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połóż go na środku. Kto pierwszy pozbędzie się wszystkich kart, wygrywa go na końcu rundy."
          }
        }
      }
    },
    "tutorial.meld.drag.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den Chip in die Mitte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This chip matters at the end."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
