    "tutorial.meld.ante.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder legt Chips aus. Passende Trumpfkarten können sie gleich gewinnen; um den Poch-Pott spielt ihr danach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each player puts 1 chip in all nine fields. These chips are won across the three parts of the round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada jugador pone 1 ficha en las nueve casillas. Estas fichas se ganan en las tres partes de la ronda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque joueur place 1 jeton dans les neuf cases. Ces jetons se gagnent au cours des trois parties de la manche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giocatore mette 1 fiche in tutte e nove le caselle. Queste fiche si vincono nelle tre parti del turno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedere speler legt 1 fiche in alle negen velden. Deze fiches worden in de drie delen van de ronde gewonnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy gracz kładzie po 1 żetonie na wszystkich dziewięciu polach. Te żetony wygrywa się w trzech częściach rundy."
          }
        }
      }
    },
