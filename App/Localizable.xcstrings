          }
        }
      }
    },
    "tutorial.meld.hand.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie gehört niemandem. Deckst du sie auf, wird ihre Kartenfarbe zum Trumpf dieser Runde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It belongs to no one. You will reveal it next: its suit becomes trump."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pertenece a nadie. Ahora la descubrirás: su palo se convierte en triunfo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle n’appartient à personne. Tu vas la retourner : sa couleur devient l’atout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non appartiene a nessuno. Ora la scoprirai: il suo seme diventa briscola."
          }
        },
        "nl" : {
          "stringUnit" : {
