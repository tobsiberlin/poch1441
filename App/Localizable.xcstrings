    "firstRun.timeSwipe.prelude.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zieh die Zeit nach vorn - vom Wirtshaus bis an deinen Tisch." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Draw Poch from the tavern to today’s table. Then play it yourself." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Lleva Poch de la taberna a la mesa de hoy. Después juegas tú." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fais passer Poch de l’auberge à la table d’aujourd’hui. Puis joue toi-même." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Porta Poch dalla taverna al tavolo di oggi. Poi gioca tu." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Trek Poch van de herberg naar de tafel van nu. Daarna speel je zelf." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Przeciągnij Poch z karczmy do dzisiejszego stołu. Potem zagraj sam." } }
      }
    },
    "firstRun.timeSwipe.prelude.eyebrow" : {
