    "tutorial.guide.finish.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer zuerst keine Karten mehr hat, nimmt die Mitte. Dazu zahlt jeder Gegner 1 Chip pro Restkarte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first player to run out of cards takes the centre. Each opponent also pays 1 chip per remaining card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien se quede primero sin cartas se lleva el centro. Además, cada rival paga 1 ficha por carta restante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier à ne plus avoir de cartes prend le centre. Chaque adversaire paie aussi 1 jeton par carte restante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi finisce per primo le carte prende il centro. Ogni avversario paga anche 1 fiche per ogni carta rimasta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie als eerste geen kaarten meer heeft, pakt het midden. Elke tegenstander betaalt ook 1 fiche per overgebleven kaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto pierwszy pozbędzie się kart, zabiera środek. Każdy przeciwnik płaci też 1 żeton za każdą pozostałą kartę."
          }
        }
      }
    },
    "tutorial.guide.finish.title" : {
