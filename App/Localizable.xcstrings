    "tutorial.bidding.uncontested.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle anderen passen. Der letzte Spieler im Gebot nimmt den Poch-Pott - ohne Aufdecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone else folds. The Poch goes to the last player still in the bidding, without a reveal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los demás pasan. El Poch es para el último jugador que sigue en la puja, sin mostrar las cartas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les autres passent. Le Poch revient au dernier joueur encore dans les mises, sans révéler les cartes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli altri passano. Il Poch va all’ultimo giocatore ancora nella puntata, senza mostrare le carte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle anderen passen. De Poch gaat zonder kaarten te tonen naar de laatste speler die nog meedoet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszyscy pozostali pasują. Poch trafia do ostatniego gracza w licytacji, bez odkrywania kart."
          }
        }
      }
    },
