    "firstRun.intro.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimmte Trumpfkarten gewinnen sofort Chips. Danach bietest du mit mindestens zwei gleichen Karten um den Poch-Pott. Wer zuerst ohne Karten ist, gewinnt die Mitte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certain trump cards win chips at once. Then you poch with a pair, triple, or four of a kind. The first player out of cards wins the centre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciertas cartas de triunfo ganan fichas al instante. Después haces poch con una pareja, un trío o cuatro iguales. Quien se quede primero sin cartas gana el centro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines cartes d’atout rapportent aussitôt des jetons. Ensuite, tu poches avec une paire, un brelan ou un carré. Le premier à ne plus avoir de cartes gagne le centre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune carte di briscola fanno vincere subito delle fiche. Poi fai poch con una coppia, un tris o un poker. Chi finisce per primo le carte vince il centro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalde troefkaarten leveren meteen fiches op. Daarna poch je met een paar, drieling of vierling. Wie als eerste geen kaarten meer heeft, wint het midden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Określone karty atutowe od razu wygrywają żetony. Potem grasz w Poch parą, trójką lub karetą. Kto pierwszy pozbędzie się kart, wygrywa środek."
          }
        }
      }
    },
