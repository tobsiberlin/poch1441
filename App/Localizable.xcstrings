    "firstRun.cinematic.accessibility.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Hana spielt die erste Runde mit dir: Passende Trumpfkarten holen Bonusfelder. Mit mindestens zwei gleichen Karten bietest du um den Poch-Pott. Wer seine Hand zuerst leert, gewinnt die Mitte." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hana plays the first round with you. Certain trump cards win fields, a pair, triple, or four of a kind lets you poch, and the first player to run out of cards wins the centre." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Hana juega la primera ronda contigo. Ciertas cartas de triunfo ganan casillas, una pareja, un trío o cuatro iguales permiten hacer poch y quien se quede primero sin cartas gana el centro." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hana joue la première manche avec toi. Certaines cartes d’atout remportent des cases, une paire, un brelan ou un carré permet de pocher et le premier à ne plus avoir de cartes gagne le centre." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Hana gioca il primo turno con te. Alcune carte di briscola vincono le caselle, una coppia, un tris o un poker permette di fare poch e chi finisce per primo le carte vince il centro." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Hana speelt de eerste ronde met je mee. Bepaalde troefkaarten winnen velden, met een paar, drieling of vierling mag je pochen en wie als eerste geen kaarten meer heeft, wint het midden." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Hana rozgrywa z tobą pierwszą rundę. Określone karty atutowe wygrywają pola, para, trójka lub kareta pozwala zagrać w Poch, a kto pierwszy pozbędzie się kart, wygrywa środek." } }
      }
    },
    "firstRun.cinematic.accessibility.people" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Hana, Noah und Jonas sitzen am Tisch. Dein Platz für die erste Runde ist frei." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hana, Noah, and Jonas are seated at the table. Your seat for the first round is open." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Hana, Noah y Jonas están sentados a la mesa. Tu sitio para la primera ronda está libre." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hana, Noah et Jonas sont assis à la table. Ta place pour la première manche est libre." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Hana, Noah e Jonas sono seduti al tavolo. Il tuo posto per il primo turno è libero." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Hana, Noah en Jonas zitten aan tafel. Je plek voor de eerste ronde is vrij." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Hana, Noah i Jonas siedzą przy stole. Twoje miejsce na pierwszą rundę jest wolne." } }
      }
    },
    "firstRun.cinematic.invitation.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ich bleibe für deine erste Runde an deiner Seite." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "I’ll stay by your side for your first round." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Estaré a tu lado durante tu primera ronda." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Je reste à tes côtés pour ta première manche." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Resto al tuo fianco per la prima mano." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Ik blijf tijdens je eerste ronde bij je." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Będę przy tobie podczas pierwszej rundy." } }
