    "firstRun.goal" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du spielst. Hana hilft nur, wenn du sie brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You play for yourself. Hana shows you why every card matters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú juegas. Hana te muestra por qué importa cada carta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu joues toi-même. Hana te montre pourquoi chaque carte compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giochi tu. Hana ti mostra perché ogni carta conta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je speelt zelf. Hana laat zien waarom elke kaart telt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grasz samodzielnie. Hana pokazuje, dlaczego każda karta ma znaczenie."
          }
        }
      }
    },
