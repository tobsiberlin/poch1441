        "it" : { "stringUnit" : { "state" : "translated", "value" : "Salta la storia" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Verhaal overslaan" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Pomiń historię" } }
      }
    },
    "firstRun.timeSwipe.takeSeat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "An den Tisch" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "To the table" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "A la mesa" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "À table" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Al tavolo" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Aan tafel" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Do stołu" } }
      }
    },
    "firstRun.timeSwipe.today.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Hol dir Chips mit passenden Trumpfkarten, fordere die anderen im Poch-Pott heraus und werde deine Karten zuerst los." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Trump brings quick wins. Then you risk chips in the Poch pot. Finally, be the first to empty your hand." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El triunfo da ganancias rápidas. Luego arriesgas fichas en el bote Poch. Al final, vacía tu mano antes que nadie." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’atout offre des gains rapides. Puis tu risques des jetons dans le pot du Poch. Enfin, vide ta main le premier." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La briscola porta vincite rapide. Poi rischi fiches nel piatto Poch. Infine, svuota la mano per primo." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Troef levert snelle winst op. Daarna riskeer je fiches in de Poch-pot. Speel ten slotte als eerste je hand leeg." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Atut daje szybkie wygrane. Potem ryzykujesz żetony w puli Poch. Na końcu pozbądź się kart jako pierwszy." } }
      }
    },
    "firstRun.timeSwipe.today.eyebrow" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "HEUTE" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "TODAY" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "HOY" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "AUJOURD’HUI" } },
