    "tutorial.bidding.stake.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Chip ist vorsichtig. Mit 2 Chips wächst der Poch-Pott - und dein Risiko."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With 1 chip, you risk little. With 2 chips, calling becomes more expensive for the others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 1 ficha arriesgas poco. Con 2 fichas, igualar les cuesta más a los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec 1 jeton, tu risques peu. Avec 2 jetons, suivre coûte plus cher aux autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 1 fiche rischi poco. Con 2 fiche, vedere costa di più agli altri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met 1 fiche riskeer je weinig. Met 2 fiches wordt meegaan duurder voor de anderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy 1 żetonie ryzykujesz niewiele. Przy 2 żetonach sprawdzenie kosztuje pozostałych więcej."
          }
        }
      }
    },
