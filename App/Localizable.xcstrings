    "firstRun.cinematic.bidding.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit mindestens zwei Karten desselben Werts darfst du pochen. Dein Einsatz entscheidet, wer im Gebot bleibt. Passen alle anderen, gehört der Poch-Pott dir. Bleiben mehrere dabei, gewinnt die stärkste Kartenkombination."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pair, three of a kind or four of a kind lets you stake. If everyone folds, the Poch is yours. If several stay, the strongest group wins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con pareja, trío o póquer puedes apostar. Si todos pasan, el Poch es tuyo. Si siguen varios, gana el grupo más fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec une paire, un brelan ou un carré, tu peux miser. Si tous passent, le Poch est à toi. Si plusieurs restent, le groupe le plus fort gagne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con coppia, tris o poker puoi puntare. Se tutti passano, il Poch è tuo. Se restano più giocatori, vince il gruppo più forte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een paar, drie- of vierling mag je inzetten. Past iedereen, dan is de Poch van jou. Blijven er meer over, dan wint de sterkste groep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z parą, trójką lub czwórką możesz stawiać. Jeśli wszyscy spasują, Poch jest twój. Gdy zostaje kilku graczy, wygrywa najsilniejsza grupa."
          }
        }
      }
    },
    "firstRun.cinematic.bidding.eyebrow" : {
      "extractionState" : "stale",
      "localizations" : {
