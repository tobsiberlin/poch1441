    "phase3.final.opponent.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nimmt die Mitte. Du zahlst 1 Chip pro Restkarte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ takes the centre. You pay 1 chip per remaining card, as long as your stack lasts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se lleva el centro. Pagas 1 ficha por carta restante mientras te queden fichas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ prend le centre. Tu paies 1 jeton par carte restante, dans la limite de ta réserve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ prende il centro. Paghi 1 fiche per ogni carta rimasta, finché ne hai."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pakt het midden. Je betaalt 1 fiche per overgebleven kaart, zolang je voorraad strekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zabiera środek. Płacisz 1 żeton za każdą pozostałą kartę, dopóki wystarczy ci żetonów."
          }
        }
      }
    },
