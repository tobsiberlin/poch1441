    "firstRun.cinematic.opening.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du siehst deine Karten offen. Bei Hana, Noah und Jonas bleiben die Werte verdeckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You see your own cards face up. Hana, Noah and Jonas show only card backs. Every chip on the board is a possible prize."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ves tus propias cartas boca arriba. De Hana, Noah y Jonas solo ves los dorsos. Cada ficha del tablero es un posible premio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous voyez vos cartes face visible. Chez Hana, Noah et Jonas, vous ne voyez que les dos. Chaque jeton du plateau est un gain possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi le tue carte scoperte. Di Hana, Noah e Jonas vedi solo il dorso. Ogni gettone sul tavolo è una possibile vincita."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ziet je eigen kaarten open. Bij Hana, Noah en Jonas zie je alleen de rug. Elke fiche op het bord kan een prijs worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swoje karty widzisz odkryte. U Hany, Noaha i Jonasa widzisz tylko rewersy. Każdy żeton na planszy może być wygraną."
          }
        }
      }
    },
    "firstRun.cinematic.opening.eyebrow" : {
      "extractionState" : "stale",
      "localizations" : {
