    "phase3.chain.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer die nächsthöhere Karte derselben Farbe hat, legt sie. Hat sie niemand, endet die Reihe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoever has the next higher card in the same suit plays it. If no one has it, the run ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga la carta inmediatamente superior del mismo palo la juega. Si nadie la tiene, la serie termina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celui qui possède la carte immédiatement supérieure de la même couleur la joue. Si personne ne l’a, la suite s’arrête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ha la carta immediatamente superiore dello stesso seme la gioca. Se non ce l’ha nessuno, la sequenza finisce."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie de eerstvolgende hogere kaart van dezelfde kleur heeft, speelt die. Heeft niemand hem, dan eindigt de reeks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kto ma kolejną wyższą kartę w tym samym kolorze, zagrywa ją. Jeśli nie ma jej nikt, sekwencja się kończy."
