    "tutorial.coach.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Trumpf, dann Pochen, zum Schluss die Hand leeren. Hana spielt die Runde mit dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three acts, three clear goals. I stay at the table until you feel the rhythm yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres actos, tres objetivos claros. Me quedo en la mesa hasta que sientas el ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois actes, trois objectifs clairs. Je reste à table jusqu'à ce que vous trouviez le rythme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre atti, tre obiettivi chiari. Resto al tavolo finché non senti il ritmo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drie bedrijven, drie heldere doelen. Ik blijf aan tafel tot je het ritme zelf voelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzy akty, trzy jasne cele. Zostaję przy stole, aż sam poczujesz rytm."
          }
        }
      }
    },
    "tutorial.completion.all.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das %@-Bonusfeld bleibt gefüllt. In der nächsten Runde kommen neue Chips dazu. Hana wartet schon auf die Revanche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ field stays filled and grows more valuable next round. From now on, you play without on-screen hints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La casilla %@ sigue llena y valdrá más en la próxima ronda. A partir de ahora juegas sin indicaciones en pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La case %@ reste remplie et vaudra davantage à la prochaine manche. Désormais, tu joues sans indications à l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La casella %@ resta piena e varrà di più nel prossimo turno. D’ora in poi giochi senza suggerimenti a schermo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het veld %@ blijft gevuld en wordt in de volgende ronde meer waard. Vanaf nu speel je zonder hints in beeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole %@ pozostaje pełne i w następnej rundzie będzie warte więcej. Od teraz grasz bez podpowiedzi na ekranie."
          }
        }
      }
    },
