    "tutorial.handoff.playout" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr baut eine Reihe in derselben Kartenfarbe: Sieben, Acht, Neun und weiter. Wer zuerst seine letzte Karte legt, gewinnt die Mitte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You lead with any card. Then whoever has the next higher card in the same suit plays it. The first player out of cards wins the centre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abres con cualquier carta. Después juega quien tenga la carta inmediatamente superior del mismo palo. Quien se quede primero sin cartas gana el centro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ouvres avec n’importe quelle carte. Ensuite, celui qui possède la carte immédiatement supérieure de la même couleur la joue. Le premier à ne plus avoir de cartes gagne le centre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri con una carta qualsiasi. Poi gioca chi ha la carta immediatamente superiore dello stesso seme. Chi finisce per primo le carte vince il centro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je opent met een willekeurige kaart. Daarna speelt degene die de eerstvolgende hogere kaart van dezelfde kleur heeft. Wie als eerste geen kaarten meer heeft, wint het midden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwierasz dowolną kartą. Potem zagrywa ten, kto ma kolejną wyższą kartę w tym samym kolorze. Kto pierwszy pozbędzie się kart, wygrywa środek."
          }
        }
      }
    },
    "tutorial.inline.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweise erscheinen nur am aktuellen Zug. Regeln und Beispiele bleiben jederzeit im Reiter Regeln verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hints appear only for the current turn. Rules and examples remain available in the Rules tab at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ayudas aparecen solo en el turno actual. Las reglas y ejemplos siguen disponibles en la pestaña Reglas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conseils n'apparaissent que pour le tour en cours. Les règles et exemples restent disponibles dans l'onglet Règles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suggerimenti appaiono solo per il turno attuale. Regole ed esempi restano sempre disponibili nella scheda Regole."
