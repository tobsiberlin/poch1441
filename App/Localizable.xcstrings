          }
        }
      }
    },
    "tutorial.meld.firstDeal.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du siehst deine Karten offen - zusammen sind sie deine Hand. Bei den anderen bleiben die Werte verdeckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your hand lies face up in front of you. You see only the backs of everyone else’s cards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mano queda boca arriba frente a ti. De las demás cartas solo ves el reverso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta main est visible devant toi. Pour les autres, tu ne vois que le dos des cartes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua mano è scoperta davanti a te. Degli altri vedi solo il dorso delle carte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hand ligt open voor je. Van de anderen zie je alleen de achterkanten van de kaarten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja ręka leży odkryta przed tobą. U pozostałych widzisz tylko rewersy kart."
          }
        }
      }
    },
    "tutorial.meld.firstDeal.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
