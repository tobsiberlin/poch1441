    "tutorial.guide.deal.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schon %d von %d Karten verteilt. Du siehst deine Werte; bei den anderen nur die Rückseiten."
