    "tutorial.bidding.transfer.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt muss Hana mitgehen, erhöhen oder aussteigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now the others are up: call, raise, or fold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora les toca a los demás: igualar, subir o pasar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est maintenant aux autres : suivre, relancer ou passer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
