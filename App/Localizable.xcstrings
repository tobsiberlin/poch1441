    "tutorial.meld.release.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du: König, Dame, Hochzeit. Noah: Zehn. Jonas: Ass. Jede Person nimmt nur ihre eigenen Bonuschips."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You: King, Queen, Marriage. Noah: Ten. Jonas: Ace. Each player takes only their own bonus chips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú: Rey, Dama, Matrimonio. Noah: Diez. Jonas: As. Cada persona toma solo sus fichas bonus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toi : Roi, Dame, Mariage. Noah : Dix. Jonas : As. Chacun prend seulement ses jetons bonus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu: Re, Regina, Matrimonio. Noah: Dieci. Jonas: Asso. Ognuno prende solo le proprie fiche bonus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij: Koning, Vrouw, Huwelijk. Noah: Tien. Jonas: Aas. Iedereen pakt alleen eigen bonusfiches."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ty: Król, Dama, Małżeństwo. Noah: Dziesiątka. Jonas: As. Każdy bierze tylko własne żetony bonusowe."
          }
        }
      }
    },
    "tutorial.meld.release.title" : {
