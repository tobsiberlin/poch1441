    "firstRun.intro.board.accessibility" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poch-Brett mit sieben Bonusfeldern, dem Poch-Pott und der Mitte"
          }
        },
        "en" : {
