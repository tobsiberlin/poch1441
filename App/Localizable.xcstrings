    "firstRun.cinematic.ready.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hana spielt mit. Deinen Einsatz und deine Startkarten wählst du selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hana joins you. You choose your own stake and lead cards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hana juega contigo. Tú eliges tu apuesta y tus cartas iniciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hana joue avec toi. Tu choisis ta mise et tes cartes de départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hana gioca con te. Scegli tu la puntata e le carte iniziali."
