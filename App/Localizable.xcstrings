    "firstRun.cinematic.playout.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Reihe steigt in derselben Kartenfarbe: 7♣, 8♣, 9♣. Wer zuerst seine letzte Karte legt, gewinnt die Mitte. Die anderen zahlen 1 Chip für jede Karte, die sie noch halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play one suit upward: 7♣, 8♣, 9♣. The first player to lay the last card wins the centre - plus chips for every card the others still hold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jugad un palo en orden ascendente: 7♣, 8♣, 9♣. Quien juegue primero su última carta gana el centro y fichas por cada carta restante de los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouez une couleur dans l’ordre : 7♣, 8♣, 9♣. Le premier à poser sa dernière carte gagne le centre, plus des jetons pour chaque carte restante des autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giocate un seme in ordine crescente: 7♣, 8♣, 9♣. Chi posa per primo l’ultima carta vince il centro e fiche per ogni carta rimasta agli altri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel één kleur oplopend uit: 7♣, 8♣, 9♣. Wie als eerste de laatste kaart legt, wint het midden plus fiches voor elke kaart die de anderen overhouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grajcie jeden kolor rosnąco: 7♣, 8♣, 9♣. Kto pierwszy zagra ostatnią kartę, wygrywa środek oraz żetony za każdą kartę pozostałą u rywali."
          }
        }
      }
    },
    "firstRun.cinematic.playout.eyebrow" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
