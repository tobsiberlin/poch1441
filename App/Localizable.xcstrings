        "es" : { "stringUnit" : { "state" : "translated", "value" : "Volver a la mesa" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retour à la table" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Torna al tavolo" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Terug naar de tafel" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Wróć do stołu" } }
      }
    },
    "help.hero.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Jeder Teil der Runde hat seinen eigenen Gewinn." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Each phase has its own prize." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cada fase tiene su propio premio." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chaque phase a son propre gain." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Ogni fase ha il suo premio." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Elke fase heeft haar eigen prijs." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Każda faza ma własną nagrodę." } }
