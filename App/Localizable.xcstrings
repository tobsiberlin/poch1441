        "es" : { "stringUnit" : { "state" : "translated", "value" : "Paga %d fichas más para seguir. Si pasas, quedas fuera; tu apuesta anterior permanece en el bote de Poch." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ajoute %d jetons pour rester dans le jeu. Si tu passes, tu sors; ta mise reste dans le pot de Poch." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Aggiungi %d fiches per restare in gioco. Se passi, sei fuori; la tua puntata resta nel piatto Poch." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Betaal nog %d fiches om mee te blijven doen. Als je past, lig je eruit; je eerdere inzet blijft in de Poch-pot." } },
