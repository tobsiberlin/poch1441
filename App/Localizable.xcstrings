    "phase3.result.opponent.body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gewinnt die Chips aus der Mitte. Für jede Karte, die du noch hältst, zahlst du 1 Chip - höchstens deinen Vorrat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ takes the centre. You pay 1 chip for every card in your hand, up to the number of chips you have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se lleva el centro. Pagas 1 ficha por cada carta de tu mano, como máximo las fichas que tengas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ prend le centre. Tu paies 1 jeton par carte dans ta main, au maximum le nombre de jetons que tu possèdes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ prende il centro. Paghi 1 fiche per ogni carta che hai in mano, fino al numero di fiche che possiedi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pakt het midden. Je betaalt 1 fiche voor elke kaart in je hand, maar nooit meer dan je hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zabiera środek. Płacisz 1 żeton za każdą kartę w ręce, najwyżej tyle, ile masz."
          }
        }
      }
    },
    "phase3.result.opponent.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die letzte Karte gelegt"
