    "tutorial.bidding.noPair.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Pochen brauchst du mindestens zwei gleiche Karten. Diesmal passt du und setzt nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without at least two cards of the same rank, you cannot poch. You fold and risk no more chips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin al menos dos cartas del mismo valor no puedes hacer poch. Pasas y no arriesgas más fichas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans au moins deux cartes de même valeur, tu ne peux pas pocher. Tu passes et ne risques aucun jeton supplémentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza almeno due carte dello stesso valore non puoi fare poch. Passi e non rischi altre fiche."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder minstens twee kaarten van dezelfde waarde mag je niet pochen. Je past en riskeert geen extra fiches."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez co najmniej dwóch kart o tej samej wartości nie możesz zagrać w Poch. Pasujesz i nie ryzykujesz kolejnych żetonów."
          }
        }
      }
    },
