    "phase3.guided.opening.choice.detail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Handkarte darf eröffnen. Danach passt nur die nächsthöhere Karte derselben Farbe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any card in your hand can open a run. After that, only the next higher card of the same suit fits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier carta de tu mano puede abrir una serie. Después solo encaja la carta inmediatamente superior del mismo palo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
