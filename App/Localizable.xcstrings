    "firstRun.cinematic.ready.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Platz ist frei."
          }
        },
        "en" : {
          "stringUnit" : {
