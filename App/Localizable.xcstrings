    "firstRun.cinematic.bidding.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit gleichen Karten darfst du pochen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matching cards get you into the Poch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cartas iguales te meten en el Poch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des cartes identiques t’ouvrent le Poch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le carte uguali ti aprono il Poch."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelijke kaarten brengen je in de Poch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takie same karty otwierają ci Poch."
          }
        }
      }
    },
    "firstRun.cinematic.bonus.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die offene Tischkarte bestimmt Trumpf. Hältst du den König dieser Kartenfarbe, zeigst du ihn: Du bekommst sofort die Chips aus dem König-Bonusfeld. Die Karte bleibt in deiner Hand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The open table card sets trump. Hold the matching trump card, show it - and take the chips from its bonus field. Your card stays in your hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta abierta de la mesa marca el triunfo. Si tienes la carta de triunfo correspondiente, muéstrala y toma las fichas de su casilla de bonificación. La carta se queda en tu mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte ouverte sur la table désigne l’atout. Si tu as la carte d’atout correspondante, montre-la et prends les jetons de sa case bonus. Ta carte reste en main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta scoperta sul tavolo stabilisce la briscola. Se hai la carta di briscola corrispondente, mostrala e prendi le fiche dalla sua casella bonus. La carta resta in mano."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De open tafelkaart bepaalt troef. Heb je de passende troefkaart, toon die dan en pak de fiches uit het bonusveld. Je kaart blijft in je hand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkryta karta na stole wyznacza atut. Jeśli masz pasującą kartę atutową, pokaż ją i zabierz żetony z jej pola bonusowego. Karta zostaje w twojej ręce."
          }
        }
      }
    },
    "firstRun.cinematic.bonus.eyebrow" : {
      "extractionState" : "stale",
      "localizations" : {
