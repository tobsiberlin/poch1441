    "tutorial.bidding.showdown.rule" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierling schlägt Drilling, Drilling schlägt Paar. Bei derselben Kombination zählt der höhere Wert; bei gleichem Paar entscheidet Trumpf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four of a kind beats a triple, and a triple beats a pair. For the same combination, the higher rank wins; for the same pair, trump decides."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuatro iguales ganan al trío y el trío a la pareja. Con la misma combinación gana el valor más alto; con la misma pareja decide el triunfo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le carré bat le brelan et le brelan bat la paire. À combinaison égale, la valeur la plus élevée gagne ; pour deux paires identiques, l’atout décide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il poker batte il tris e il tris batte la coppia. A parità di combinazione vince il valore più alto; con la stessa coppia decide la briscola."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vierling verslaat een drieling en een drieling een paar. Bij dezelfde combinatie wint de hoogste waarde; bij hetzelfde paar beslist troef."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kareta bije trójkę, a trójka parę. Przy takim samym układzie wygrywa wyższa wartość; przy takiej samej parze decyduje atut."
          }
        }
      }
    },
