    "tutorial.meld.boardTour.king" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dein Trumpf-König" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your trump king" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu rey de triunfo" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ton roi d’atout" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il tuo re di briscola" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Jouw troefkoning" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Twój król atutowy" } }
      }
    },
    "tutorial.meld.claim.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erhältst König, Dame und Hochzeit. Danach melden Noah und Jonas ihre Trumpfkarten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You receive King, Queen and Marriage. Noah and Jonas then meld their trump cards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibes Rey, Dama y Matrimonio. Después Noah y Jonas muestran sus triunfos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reçois Roi, Dame et Mariage. Noah et Jonas annoncent ensuite leurs atouts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi Re, Regina e Matrimonio. Poi Noah e Jonas dichiarano le loro briscole."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je krijgt Koning, Vrouw en Huwelijk. Daarna melden Noah en Jonas hun troefkaarten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymujesz Króla, Damę i Małżeństwo. Potem Noah i Jonas meldują swoje atuty."
          }
        }
      }
    },
    "tutorial.meld.claim.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Hochzeit zahlt dreifach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Marriage pays three times"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Matrimonio paga tres veces"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Mariage paie trois fois"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Matrimonio paga tre volte"
          }
        },
        "nl" : {
          "stringUnit" : {
