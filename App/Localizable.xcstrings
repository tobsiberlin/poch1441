    "tutorial.guide.trump.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Kartenfarbe wird Trumpf. Die Karte selbst gehört niemandem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its suit becomes trump. The table card itself belongs to no hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su palo se convierte en triunfo. La carta de la mesa no pertenece a ninguna mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa couleur devient l’atout. La carte de table elle-même n’appartient à aucune main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo seme diventa briscola. La carta sul tavolo non appartiene a nessuna mano."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kleur wordt troef. De tafelkaart zelf hoort bij geen enkele hand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jej kolor staje się atutem. Sama karta na stole nie należy do żadnej ręki."
          }
        }
      }
    },
