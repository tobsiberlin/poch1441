    "tutorial.handoff.bidding" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit mindestens zwei gleichen Karten darfst du bieten. Passen alle anderen, gehört der Poch-Pott dir. Bleiben mehrere im Gebot, gewinnt die stärkste Gruppe gleicher Karten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pair, triple, or four of a kind lets you stake chips. If several players stay in, they reveal their combinations; the strongest wins the Poch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pareja, un trío o cuatro iguales te permiten apostar fichas. Si siguen varios jugadores, muestran sus combinaciones; la más fuerte gana el Poch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une paire, un brelan ou un carré te permet de miser des jetons. Si plusieurs joueurs restent, ils révèlent leurs combinaisons ; la plus forte remporte le Poch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una coppia, un tris o un poker ti permette di puntare fiche. Se restano più giocatori, mostrano le combinazioni; la più forte vince il Poch."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een paar, drieling of vierling mag je fiches inzetten. Blijven er meerdere spelers over, dan tonen ze hun combinaties; de sterkste wint de Poch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para, trójka lub kareta pozwala stawiać żetony. Jeśli zostanie kilku graczy, pokazują układy; najsilniejszy wygrywa Poch."
          }
        }
      }
    },
    "tutorial.handoff.meld" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passende Trumpfkarten bringen dir sofort die Chips aus ihren Bonusfeldern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The table card sets the trump suit. The trump ace, king, queen, jack, and ten win their field; King+Queen and 7-8-9 win additional fields."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta de la mesa marca el palo de triunfo. El as, rey, reina, jota y diez de triunfo ganan su casilla; Rey+Reina y 7-8-9 ganan casillas adicionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte de table détermine la couleur d’atout. L’as, le roi, la dame, le valet et le dix d’atout remportent leur case ; Roi+Dame et 7-8-9 remportent des cases supplémentaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta sul tavolo stabilisce il seme di briscola. Asso, re, regina, fante e dieci di briscola vincono la loro casella; Re+Regina e 7-8-9 vincono caselle aggiuntive."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tafelkaart bepaalt de troefkleur. Troefaas, -koning, -vrouw, -boer en -tien winnen hun veld; Koning+Vrouw en 7-8-9 winnen extra velden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta na stole wyznacza kolor atutowy. Atutowy as, król, dama, walet i dziesiątka wygrywają swoje pole; Król+Dama i 7-8-9 wygrywają dodatkowe pola."
          }
        }
      }
    },
