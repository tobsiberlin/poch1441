    "tutorial.guide.trump.revealed.body" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bestimmte %@-Karten gewinnen jetzt sofort die Chips aus ihren Bonusfeldern." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Certain %@ cards now immediately win the chips in their bonus fields." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Algunas cartas de %@ ganan ahora de inmediato las fichas de sus campos de bonificación." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Certaines cartes de %@ remportent maintenant immédiatement les jetons de leurs cases bonus." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Alcune carte di %@ vincono subito le fiches dei rispettivi campi bonus." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Bepaalde %@-kaarten winnen nu meteen de fiches uit hun bonusvelden." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Wybrane karty %@ od razu zdobywają żetony ze swoich pól premiowych." } }
      }
    },
