    "phase3.lead.hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Reihe ist beendet. Weil du zuletzt gelegt hast, eröffnest du neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The run has ended. Because you played last, you lead again."
