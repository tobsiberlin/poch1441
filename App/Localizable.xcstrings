    "tutorial.bidding.reply.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitgehen: +%d Chip zum Einsatz. Wenn du passt, steigst du aus; dein bisheriger Einsatz bleibt im Poch-Pott."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call: add %d chip to your stake. If you fold, your current stake stays in the Poch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igualar: añade %d ficha a tu apuesta. Si pasas, tu apuesta actual se queda en el Poch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivre : ajoute %d jeton à ta mise. Si tu passes, ta mise actuelle reste dans le Poch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedere: aggiungi %d fiche alla puntata. Se passi, la puntata attuale resta nel Poch."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meegaan: voeg %d fiche toe aan je inzet. Als je past, blijft je huidige inzet in de Poch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdzenie: dodaj %d żeton do stawki. Jeśli spasujesz, dotychczasowa stawka zostaje w Poch."
          }
        }
      }
    },
    "tutorial.bidding.reply.body.one" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zahle 1 weiteren Chip, um im Gebot zu bleiben. Passt du, bist du raus; dein bisheriger Einsatz bleibt im Poch-Pott." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Pay 1 more chip to stay in. If you fold, you are out; your previous stake stays in the Poch pot." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Paga 1 ficha más para seguir. Si pasas, quedas fuera; tu apuesta anterior permanece en el bote de Poch." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ajoute 1 jeton pour rester dans le jeu. Si tu passes, tu sors; ta mise reste dans le pot de Poch." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Aggiungi 1 fiche per restare in gioco. Se passi, sei fuori; la tua puntata resta nel piatto Poch." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Betaal nog 1 fiche om mee te blijven doen. Als je past, lig je eruit; je eerdere inzet blijft in de Poch-pot." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Dołóż 1 żeton, aby zostać w grze. Jeśli spasujesz, odpadasz; wcześniejsza stawka zostaje w puli Poch." } }
      }
    },
    "tutorial.bidding.reply.body.many" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zahle %d weitere Chips, um im Gebot zu bleiben. Passt du, bist du raus; dein bisheriger Einsatz bleibt im Poch-Pott." } },
